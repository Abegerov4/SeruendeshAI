# Optional local primary UI profile. No paid calls or external email by default.
LLM_ENABLED=false
LLM_WARMUP_ENABLED=false
EMBED_MODEL=off
WEATHER_ENABLED=false
READINESS_PROFILE=template
# OPENAI_API_KEY= (set locally; never commit)
# DATABASE_URL=postgresql://user:password@host/database
# PUBLIC_URL=https://your-host.example
# SMTP_HOST=...
# SMTP_PORT=587
# SMTP_FROM=...
# SMTP_USER=...
# SMTP_PASSWORD=...
FLIGHT_DOMESTIC_BUFFER_MIN=120
FLIGHT_INTERNATIONAL_BUFFER_MIN=180
FLIGHT_UNKNOWN_BUFFER_MIN=180
DEADLINE_ROAD_UNCERTAINTY_MIN=15
FORWARDED_ALLOW_IPS=127.0.0.1
