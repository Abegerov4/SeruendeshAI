# Copy to .env and fill in. .env is gitignored — never commit real keys.
OPENAI_API_KEY=sk-...

# Optional Langfuse tracing (backend/app/tracing.py): off without both keys.
# Traces get the masked query and place data; never coordinates, home or photos.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_ENVIRONMENT=development   # production on Railway

# Optional card-photo stack: compose.yaml + compose.photos.yaml
# SeaweedFS requires credentials; use a long random secret (at least 16 characters).
# S3_ACCESS_KEY_ID=photo-admin
# S3_SECRET_ACCESS_KEY=
# URL reachable by browsers/bot clients, including the bucket name.
# S3_PUBLIC_BASE_URL=http://localhost:9000/place-photos

# Optional tuning (defaults shown)
# LLM_MODELS=gpt-6-luna,gpt-5.6-luna,gpt-4.1-mini
# LLM_PARSE_MODEL=gpt-6-luna
# LLM_SERVICE_TIER=fast
# LLM_TIMEOUT_S=8
# EMBED_MODEL=e5-large        # e5-large (~1 GB RAM) | e5-base | e5-small (~0.5 GB) | off
# WEATHER_ENABLED=true
# BOT_API_KEY=              # shared secret with the Telegram bot (its SERU_BOT_KEY): per-user rate limits
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
