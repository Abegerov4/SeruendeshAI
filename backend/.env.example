# Скопируй в .env (в корне репозитория) и заполни. .env в git не коммитим.

# OpenAI-совместимый провайдер. Для Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=
LLM_BASE_URL=

# fast — разбор запроса (temperature=0); decision — выбор мест и объяснение «почему»
LLM_FAST_MODEL=gpt-5.4-mini
LLM_DECISION_MODEL=gpt-6.1-sol
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_S=25

# 1 — работать на backend/tests/fixtures/pois_sample.json, пока нет пакета rag/
MOCK_RAG=0

# Через запятую, * — разрешить всем (для хакатона ок)
CORS_ORIGINS=*

# Таймаут именно decision-модели; после него отвечает fast-модель
LLM_DECISION_TIMEOUT_S=8
# Свои цены за 1M токенов (input/output), если отличаются от встроенных
LLM_PRICES=

# Кэш ответов
CACHE_TTL_S=900
CACHE_MAX_ITEMS=500

# Langfuse (опционально; без ключей трейсинг выключен)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Telegram-бот (python -m backend.telegram_bot.bot)
TELEGRAM_BOT_TOKEN=
